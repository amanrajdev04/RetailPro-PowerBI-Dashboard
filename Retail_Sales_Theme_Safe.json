{
  "name": "SalesPulse Theme",
  "dataColors": [
    "#1F3864",
    "#2E86AB",
    "#F18F01",
    "#3BB273",
    "#7768AE",
    "#C73E1D",
    "#4D5B6C",
    "#A5B4C4"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3864",
  "good": "#3BB273",
  "neutral": "#F6AE2D",
  "bad": "#C73E1D",
  "maximum": "#1F3864",
  "center": "#F6AE2D",
  "minimum": "#C73E1D",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4D5B6C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "fontSize": 13
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E1E6EE" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F3F5F9" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
