{
  "name": "Retail Sales Dashboard",
  "dataColors": [
    "#1F3864",
    "#2E86AB",
    "#F18F01",
    "#3BB273",
    "#7768AE",
    "#C73E1D",
    "#4D5B6C",
    "#A5B4C4"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3864",
  "good": "#3BB273",
  "neutral": "#F6AE2D",
  "bad": "#C73E1D",
  "maximum": "#1F3864",
  "center": "#F6AE2D",
  "minimum": "#C73E1D",
  "null": "#A5B4C4",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4D5B6C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E1E6EE" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 90,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F3F5F9" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#E9EDF3" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F3864" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 11
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "fontSize": 11
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 10,
            "gridlineColor": { "solid": { "color": "#E9EDF3" } }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": { "solid": { "color": "#4D5B6C" } }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2937" } },
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#4D5B6C" } },
            "fontSize": 10,
            "gridlineColor": { "solid": { "color": "#E9EDF3" } }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top"
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Right",
            "labelColor": { "solid": { "color": "#4D5B6C" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2937" } },
            "labelStyle": "Percent of total"
          }
        ]
      }
    }
  }
}
